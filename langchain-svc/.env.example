# Contoh config langchain-svc — copy ke .env lalu isi.
# File .env asli TIDAK di-commit (lihat .gitignore).
KIOSAPI_API_KEY=sk-isi-dari-kiosapi.com
KIOSAPI_MODEL=agnes-2.5-flash
PORT=8787

# Token rahasia antara Laravel <-> service ini.
# Samakan dengan LANGCHAIN_SERVICE_TOKEN di .env Laravel.
# Kosong = mode DEV (tanpa auth, hanya untuk belajar lokal).
LANGCHAIN_INTERNAL_TOKEN=isi-string-acak-panjang-min-32-karakter

# Timeout panggilan AI (ms)
AI_TIMEOUT_MS=60000

# Versi prompt — naikkan tiap ubah template di server.js (mis. v1.2.0).
# Muncul di /health, /chat, dan log agar mudah debug. Gratis.
PROMPT_VERSION=v1.2.0

# LangSmith tracing (opsional, ada free-tier di smith.langchain.com).
# Gratis untuk riset: daftar, buat API key, lalu uncomment 3 baris ini.
# Tanpa ini pun service tetap jalan — observability dasar (timing + token
# usage) sudah di-log ke stdout tanpa layanan tambahan.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_isi-dari-smith.langchain.com
# LANGCHAIN_PROJECT=dompetku-ai
